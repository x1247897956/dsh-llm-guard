# LLM Guard 环境变量样例（只放字段名，不放真值）
# 复制为 service/.env 后填入自己的 key：cp .env.example service/.env

# --- 语义层（可选）---
# 不配置时服务自动降级为纯规则版（/health 会显示 semantic.enabled=false）
DEEPSEEK_API_KEY=

# OpenAI 兼容 /chat/completions 的 base_url（可替换为任意兼容网关）
LLM_GUARD_BASE_URL=https://api.deepseek.com

# 请求体里声明的模型 ID
LLM_GUARD_MODEL=deepseek-chat

# 单次请求超时（秒）
LLM_GUARD_TIMEOUT=30

# 失败重试次数（不含首次请求）
LLM_GUARD_RETRIES=2

# --- 服务（可选）---
LLM_GUARD_HOST=127.0.0.1
LLM_GUARD_PORT=8000
